# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# Optional: enables Claude-written incident explanations. Without it a built-in template is used.
ANTHROPIC_API_KEY=
# auto = use Claude when a key is set, template = never call the API
SENTINEL_AI_ANALYST=auto
# SENTINEL_LLM_MODEL=claude-opus-5

# Login. Change these before showing the app outside a demo.
ADMIN_USERNAME=TOBY
ADMIN_PASSWORD=5429
# Set a long random value to keep people logged in across restarts
# SECRET_KEY=

# Admin sign-in also needs a code from an authenticator app (true/false)
ADMIN_2FA=true
# Staff sign-in needs a one-time code sent by email (true/false)
OTP_REQUIRED=true
# Where login / denial / attack alerts go (can also be set on the Access Control page)
ADMIN_EMAIL=

# Real email delivery. Without these, emails are shown in the dashboard's Mail Outbox (demo mode).
# Gmail: turn on 2-step verification, create an "App password", and use it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# MAIL_FROM=

# Background "company activity" that keeps the dashboard live
LIVE_TRAFFIC=true
LIVE_INTERVAL_SECONDS=8

# Local runs use SQLite by default. Docker Compose sets PostgreSQL automatically.
# DATABASE_URL=sqlite:///./sentinel.db

# ---- Integrations (optional; can also be set on the Integrations page) ----
# Alerts out
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
# Logs in: a fixed key for POST /api/ingest/<okta|entra|google|cloudtrail|sentinel> (header X-API-Key)
INGEST_API_KEY=
